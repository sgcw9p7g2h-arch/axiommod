<Window x:Class="AxiomLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axiom Launcher"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AxiomBackground}"
        Foreground="{StaticResource AxiomText}">
  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="AXIOM" FontSize="34" FontWeight="Bold"/>
      <TextBlock Text="Minecraft launcher" Foreground="{StaticResource AxiomMuted}" Margin="0,3,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource AxiomPanel}" CornerRadius="14" Margin="0,28,0,28" Padding="28">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Axiom Profile" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Fabric 1.21.11 • Axiom client" Foreground="{StaticResource AxiomMuted}" Margin="0,7,0,0"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
          <TextBlock Text="Minecraft version" Foreground="{StaticResource AxiomMuted}"/>
          <ComboBox x:Name="VersionBox" Margin="0,8,0,18" Height="38" SelectedIndex="0">
            <ComboBoxItem Content="1.21.11"/>
          </ComboBox>

          <TextBlock Text="Game directory" Foreground="{StaticResource AxiomMuted}"/>
          <TextBox x:Name="GameDirBox" Margin="0,8,0,0" Height="38"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="LaunchButton" Content="LAUNCH AXIOM"
                Height="52" FontSize="16" FontWeight="Bold"
                Click="LaunchButton_Click"/>
      </Grid>
    </Border>

    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource AxiomMuted}"/>
      <Button DockPanel.Dock="Right" Content="Settings" Padding="18,8" Click="SettingsButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
